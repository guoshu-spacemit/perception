# The packaged runtime contains the matched ORT/EP/TCM ELF payloads. It is a
# target library, not a host tool; reject the wrong target before linking it.
set(LAS2_ORT_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/onnxruntime/include")
set(LAS2_EMBEDDED_RUNTIME_LIBRARY
  "${CMAKE_CURRENT_SOURCE_DIR}/lib/libstereo_matching_runtime.so")
foreach(_las2_runtime_header onnxruntime_c_api.h onnxruntime_cxx_api.h spacemit_ort_env.h)
  if(NOT EXISTS "${LAS2_ORT_INCLUDE_DIR}/${_las2_runtime_header}")
    message(FATAL_ERROR "Bundled LAS2 runtime header is missing: ${_las2_runtime_header}")
  endif()
endforeach()
if(NOT EXISTS "${LAS2_EMBEDDED_RUNTIME_LIBRARY}")
  message(FATAL_ERROR
    "Bundled LAS2 runtime is missing: ${LAS2_EMBEDDED_RUNTIME_LIBRARY}. "
    "Use the complete SDK checkout or explicitly select ONNXRUNTIME_ROOT.")
endif()

file(READ "${CMAKE_CURRENT_SOURCE_DIR}/RUNTIME_CONTRACT.json" _las2_runtime_contract)
string(REGEX MATCH
  "\"embedded_library_sha256\"[ \t\r\n]*:[ \t\r\n]*\"([0-9a-f]+)\""
  _las2_runtime_hash_field "${_las2_runtime_contract}")
set(_las2_runtime_expected_hash "${CMAKE_MATCH_1}")
string(LENGTH "${_las2_runtime_expected_hash}" _las2_runtime_hash_length)
if(NOT _las2_runtime_hash_length EQUAL 64)
  message(FATAL_ERROR "RUNTIME_CONTRACT.json must identify the bundled runtime SHA256")
endif()
file(SHA256 "${LAS2_EMBEDDED_RUNTIME_LIBRARY}" _las2_runtime_actual_hash)
if(NOT _las2_runtime_actual_hash STREQUAL _las2_runtime_expected_hash)
  message(FATAL_ERROR "Bundled LAS2 runtime SHA256 does not match RUNTIME_CONTRACT.json")
endif()

file(READ "${LAS2_EMBEDDED_RUNTIME_LIBRARY}" _las2_runtime_elf HEX LIMIT 52)
string(LENGTH "${_las2_runtime_elf}" _las2_runtime_elf_length)
if(_las2_runtime_elf_length LESS 104 OR NOT _las2_runtime_elf MATCHES "^7f454c460201")
  message(FATAL_ERROR "Bundled LAS2 runtime must be a little-endian ELF64 shared library")
endif()
string(SUBSTRING "${_las2_runtime_elf}" 32 4 _las2_runtime_elf_type)
if(NOT _las2_runtime_elf_type STREQUAL "0300")
  message(FATAL_ERROR "Bundled LAS2 runtime must be an ELF shared library (ET_DYN)")
endif()
string(SUBSTRING "${_las2_runtime_elf}" 36 4 _las2_runtime_machine)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _las2_runtime_target)
if(CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "Bundled LAS2 runtime requires a 64-bit target toolchain")
endif()
if(_las2_runtime_target MATCHES "riscv")
  set(_las2_runtime_expected_machine "f300")
elseif(_las2_runtime_target MATCHES "^(x86_64|amd64)$")
  set(_las2_runtime_expected_machine "3e00")
elseif(_las2_runtime_target MATCHES "^(aarch64|arm64)$")
  set(_las2_runtime_expected_machine "b700")
else()
  message(FATAL_ERROR "Unsupported bundled LAS2 runtime target: ${CMAKE_SYSTEM_PROCESSOR}")
endif()
if(NOT _las2_runtime_machine STREQUAL _las2_runtime_expected_machine)
  message(FATAL_ERROR
    "Bundled LAS2 runtime ELF machine does not match target ${CMAKE_SYSTEM_PROCESSOR}; "
    "the distributed runtime is for RISC-V64. Select a matching ONNXRUNTIME_ROOT for another target.")
endif()
if(_las2_runtime_target MATCHES "riscv")
  string(SUBSTRING "${_las2_runtime_elf}" 96 2 _las2_runtime_flags)
  math(EXPR _las2_runtime_float_abi "0x${_las2_runtime_flags} & 6")
  if(NOT _las2_runtime_float_abi EQUAL 4)
    message(FATAL_ERROR "Bundled LAS2 runtime requires the RISC-V LP64D float ABI")
  endif()
endif()
set(_las2_runtime_libraries "${LAS2_EMBEDDED_RUNTIME_LIBRARY}")
set(_las2_runtime_build_rpath "${CMAKE_CURRENT_SOURCE_DIR}/lib")
